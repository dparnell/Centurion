IO_LOC  "LED8" 26;

IO_LOC  "LED7" 25;

IO_LOC  "in_clk" 52;
IO_PORT "in_clk" PULL_MODE=UP;

IO_LOC  "LED1" 10;
IO_PORT "LED1" DRIVE=8 PULL_MODE=UP;

IO_LOC  "LED2" 11;
IO_PORT "LED2" DRIVE=8 PULL_MODE=UP;

IO_LOC  "LED3" 13;
IO_PORT "LED3" DRIVE=8 PULL_MODE=UP;

IO_LOC  "LED4" 14;
IO_PORT "LED4" DRIVE=8 PULL_MODE=UP;

IO_LOC  "LED5" 15;
IO_PORT "LED5" DRIVE=8 PULL_MODE=UP;

IO_LOC  "LED6" 16;
IO_PORT "LED6" DRIVE=8 PULL_MODE=UP;

IO_LOC  "reset_btn" 3;
// The buttons short the pin to ground when pressed and have no external pull up,
// so without this the input floats and reset is undefined.
IO_PORT "reset_btn" PULL_MODE=UP;

IO_LOC  "btn2" 4;
IO_PORT "btn2" PULL_MODE=UP;

// Pin directions are from the FPGA's point of view: it transmits on 17 and receives
// on 18. These used to be the other way round, so the design drove pin 18, which the
// FT2232 also drives, and listened on pin 17, which nothing drives.
IO_LOC  "uart_tx" 17;

IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" PULL_MODE=UP;
